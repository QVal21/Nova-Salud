# Copia este archivo como .env y completa los valores. El .env NUNCA se sube a GitHub.

# Cadena de MongoDB Atlas (con tu usuario, contraseña y /novasalud antes del ?)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@nova-salud.xxxxx.mongodb.net/novasalud?retryWrites=true&w=majority&appName=nova-salud

# Frase larga y difícil de adivinar para firmar los tokens
JWT_SECRET=cambia-esto-por-una-frase-larga-y-secreta

# Duración de la sesión (un turno)
JWT_EXPIRES_IN=8h

PORT=4000

# Orígenes permitidos (separados por coma). Al publicar, agrega la URL del frontend.
CORS_ORIGIN=http://localhost:5173
